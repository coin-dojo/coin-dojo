{
  "name": "coin-dojo",
  "version": 1,
  "about": "coin-dojo style kit: the tokens of what already ships in themes/coin-dojo (colors.xml indigo scheme, skills/badges/gen_help.py, gen_chips.py, badge.py, skills/controls/controls.py). Rules: brand/BRAND.md. Loader: brand/brand.py.",
  "screen": {
    "panel": [1920, 1080],
    "safe_area": [1440, 1080],
    "safe_origin": [240, 0],
    "note": "Iconic's bezel crops the 1920x1080 panel to a centred 4:3 area; ES-DE runs at 1440x1080 with --fullscreen-padding. Keep every pixel of UI inside 1440x1080."
  },
  "colors": {
    "bg":            {"hex": "0E0822", "role": "base: violet-black screen background (colors.xml baseColor)"},
    "bg_deep":       {"hex": "08061A", "role": "deepest fill: stick well on the controls card"},
    "panel":         {"hex": "1B1542", "role": "raised panel / inner box (controls.py PANEL)"},
    "card":          {"hex": "141030", "role": "card and overlay fill (controls.py NAVY)"},
    "button":        {"hex": "2A1F5C", "role": "button / key cap fill (controls.py BTN)"},
    "text":          {"hex": "FFF4DC", "role": "primary text, cream (colors.xml textPrimary)"},
    "text_soft":     {"hex": "E4DCF7", "role": "long text / descriptions (colors.xml descColor)"},
    "chrome":        {"hex": "E6E9F2", "role": "labels on buttons and key caps (controls.py CHROME)"},
    "muted":         {"hex": "C9C0EA", "role": "secondary text, lavender (colors.xml textMuted, hotkey words)"},
    "muted_card":    {"hex": "B9BDD6", "role": "secondary text on cards (controls.py MUTED)"},
    "dimmed":        {"hex": "8A7FB0", "role": "disabled / dimmed help entries (colors.xml helpDimmed)"},
    "dim":           {"hex": "4A4380", "role": "empty slots, rules and outlines (controls.py DIM)"},
    "gold":          {"hex": "FFC94D", "role": "THE accent: selector, labels, counters, help badges (colors.xml listSelector/labelColor, gen_help GOLD)"},
    "gold_card":     {"hex": "E8B840", "role": "accent on cards: borders, titles, stick ball (controls.py GOLD)"},
    "gold_muted":    {"hex": "D6B670", "role": "secondary-row badges: the hotkey strip (gen_help HK_GOLD)"},
    "on_gold":       {"hex": "1A0A22", "role": "text on a gold selector bar (colors.xml listSelected)"},
    "crimson":       {"hex": "E23B3B", "role": "Crimson red, secondary accent: right panel stripe, errors"},
    "red_light":     {"hex": "FF6B5A", "role": "light red highlight"},
    "salmon":        {"hex": "FF8F78", "role": "list secondary text (colors.xml listSecondary)"},
    "lavender":      {"hex": "BEAAFF", "role": "SYSTEM chip, small caveat notes (gen_help LAV)"},
    "pending":       {"hex": "9AA0C0", "role": "PENDING / NOT TESTED border and tag (controls.py PENDING)"},
    "navy":          {"hex": "180A28", "role": "chip fill + pictogram outline (gen_chips NAVY)"},
    "badge_outline": {"hex": "09163A", "role": "carousel badge outline (badge.py NAVY)"},
    "counter_bg":    {"hex": "2A0B22", "role": "game counter pill (colors.xml gameCounterBg, alpha D8)"},
    "decade":        {"hex": "F05468", "role": "DECADE chip accent"},
    "cyan":          {"hex": "36D6E7", "role": "GENRE chip only (small details, never text on panels)"},
    "white":         {"hex": "FFFFFF", "role": "help-icon masks (tinted by the theme)"},
    "bezel":         {"hex": "000000", "role": "outside the 4:3 area (the 240 px side bars the bezel hides): plain black"}
  },
  "alpha": {
    "chip_fill": 235,
    "counter_bg": 216,
    "scrim_footer": 217
  },
  "gradients": {
    "badge": {"role": "carousel badge face, over the glyph height (badge.py STOPS)",
              "stops": [[0.00, "FCEFC3"], [0.25, "FDE08C"], [0.50, "FDB643"], [0.70, "BDBD72"], [0.90, "73CAB1"], [1.00, "3DA6AE"]]},
    "pictogram": {"role": "genre pictogram fill (gen_chips STOPS)",
                  "stops": [[0.0, "FCEFC3"], [0.3, "FDD678"], [0.55, "FDB643"], [0.8, "96C48C"], [1.0, "3DA6AE"]]}
  },
  "chips": {
    "curated": {"label": "CURATED", "color": "gold"},
    "decade":  {"label": "DECADE",  "color": "decade"},
    "genre":   {"label": "GENRE",   "color": "cyan"},
    "system":  {"label": "SYSTEM",  "color": "lavender"},
    "browse":  {"label": "BROWSE",  "color": "text"},
    "setup":   {"label": "SETUP",   "color": "muted"},
    "exit":    {"label": "EXIT",    "color": "salmon"}
  },
  "fonts": {
    "dir": "themes/coin-dojo/_inc/fonts",
    "display": {"file": "ArchivoBlack-Regular.ttf", "family": "Archivo Black", "license": "OFL", "use": "titles, badges, round button labels"},
    "ui_bold": {"file": "Rajdhani-Bold.ttf", "family": "Rajdhani Bold", "license": "OFL", "use": "pill labels, tags, hotkey words, values"},
    "ui_semi": {"file": "Rajdhani-SemiBold.ttf", "family": "Rajdhani SemiBold", "license": "OFL", "use": "body text, metadata, list rows"},
    "ui_medium": {"file": "Rajdhani-Medium.ttf", "family": "Rajdhani Medium", "license": "OFL", "use": "long text"},
    "pixel": {"file": "PressStart2P-Regular.ttf", "family": "Press Start 2P", "license": "OFL", "use": "clock, counters, small retro accents only"}
  },
  "type_scale": {
    "unit": "px on the 1080-tall screen",
    "title": 52,
    "heading": 34,
    "body": 30,
    "label": 26,
    "help": 24,
    "small": 20,
    "hotkey": 18
  },
  "spacing": {"xs": 4, "s": 8, "m": 16, "l": 24, "xl": 40, "xxl": 56},
  "radius": {"tag": 8, "box": 18, "card": 24, "overlay": 28, "pill": "height/2"},
  "border": {"rule": 2, "pill": 3, "box": 3, "card": 5, "overlay": 6},
  "badge_pill": {
    "source": "skills/badges/gen_help.py",
    "height": 128,
    "supersample": 4,
    "round_width": 142,
    "pill_pad": 70,
    "cap_round": 0.68,
    "cap_pill": 0.72,
    "condense_fit": 0.86,
    "track": -1,
    "round_font": "display",
    "pill_font": "ui_bold",
    "fill": "white",
    "tint": "gold",
    "label": "knocked out (transparent letters); the theme tints the mask",
    "round_labels": ["LP", "MP", "HP", "LK", "MK", "HK"],
    "pill_labels": ["START", "SELECT", "HP+HK"]
  },
  "card": {
    "source": "skills/controls/controls.py render_card",
    "size": [706, 340],
    "radius": 24,
    "border": 5,
    "fill": "card",
    "border_tested": "gold_card",
    "border_pending": "pending",
    "title_font": "display",
    "title_px": 30,
    "title_pos": [26, 22],
    "tag_text": "NOT TESTED",
    "tag_font": "ui_bold",
    "tag_px": 26,
    "tag_radius": 8,
    "tag_fill": "pending",
    "tag_text_color": "card",
    "pill_width": 132,
    "pill_fill": "button",
    "pill_outline": "muted_card",
    "pill_text": "chrome"
  },
  "help_bar": {
    "primary": {"what": "ES-DE help bar: button badges + action words", "font_px": 24, "icon_color": "gold", "text_color": "text", "dimmed": "dimmed", "case": "upper"},
    "secondary": {"what": "hotkey strip above the help bar (START+SELECT exit ...)", "height_px": 32, "badge_px": 15, "word_px": 18, "badge_color": "gold_muted", "word_color": "muted", "rule": "always smaller and quieter than the primary row"}
  },
  "contrast": {
    "min": 4.5,
    "pairs": [
      ["text", "bg"],
      ["text_soft", "bg"],
      ["muted", "bg"],
      ["gold", "bg"],
      ["salmon", "bg"],
      ["on_gold", "gold"],
      ["text", "card"],
      ["muted", "card"],
      ["gold", "card"],
      ["chrome", "button"],
      ["muted_card", "card"],
      ["gold_card", "card"],
      ["card", "pending"],
      ["red_light", "bg"],
      ["red_light", "card"],
      ["salmon", "card"],
      ["gold_muted", "bg"],
      ["text", "panel"],
      ["gold", "panel"],
      ["muted_card", "panel"]
    ]
  }
}
