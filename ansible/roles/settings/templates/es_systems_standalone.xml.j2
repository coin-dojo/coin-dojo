<?xml version="1.0"?>
<!-- coin-dojo-settings-standalone: written by the settings role (#35) on a host without the collgen nested build
     (the test VM). No loadExclusive: the bundled systems stay. Same <system> block as nested.systems_xml. -->
<systemList>
  <system>
    <name>settings</name>
    <fullname>SETTINGS</fullname>
    <path>{{ settings_carousel_root }}/settings</path>
    <extension>.hks</extension>
    <command>{{ settings_command }} %ROM%</command>
    <platform>ignore</platform>
    <theme>settings</theme>
    <systemsortname>9-settings</systemsortname>
  </system>
</systemList>
