<!-- The eye glow (#105, #263), generated by skills/badges/gen_eye_glow.py from the night backdrop.
     theme.xml includes it through ${eyeGlow}; without this file ES-DE logs a debug line and renders on. -->
<theme>
    <view name="system">
        <animation name="eyeGlow">
            <pos>0.47222 0.07870</pos>
            <size>0.19444 0.24074</size>
            <path>./eye-glow.json</path>
            <interpolation>linear</interpolation>
            <iterationCount>0</iterationCount>
            <zIndex>2.5</zIndex>
        </animation>
    </view>
    <view name="gamelist">
        <animation name="eyeGlow">
            <pos>0.47222 0.07870</pos>
            <size>0.19444 0.24074</size>
            <path>./eye-glow.json</path>
            <interpolation>linear</interpolation>
            <iterationCount>0</iterationCount>
            <zIndex>2.5</zIndex>
        </animation>
    </view>
</theme>
